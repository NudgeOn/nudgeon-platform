# Onda 환경변수 (12-Factor — PRD-08 1장). 모든 값에 기본값이 있으며, 로컬 dev는 그대로 동작한다.
#
# 주의: 이 파일의 주소는 "호스트에서 api/worker를 직접 실행"할 때용(localhost:5433 등)이다.
# Compose app 프로파일로 컨테이너를 띄우는 셀프호스팅은 deploy/.env.example을 쓸 것
# (컨테이너 내부 서비스명 postgres/redis/clickhouse 기준).

# --- 공통 (api · worker) ---
# PostgreSQL — 현재 상태 저장소. 관리형(RDS 등) 연결은 URL 교체만으로 지원.
DATABASE_URL=postgres://onda:onda@localhost:5433/onda
# Redis — 큐(Streams)·세션 캐시·rate limit·dedup. AOF everysec 권장.
REDIS_URL=redis://localhost:6379
# ClickHouse — 수집·로그·분석 (HTTP 인터페이스, api·worker 공용)
CLICKHOUSE_URL=http://onda:onda@localhost:8123/onda

# --- api ---
PORT=8080
# multi_tenant(SaaS) | single_tenant(셀프호스팅 — 가입 대신 초기 관리자 셋업)
MODE=multi_tenant
SESSION_TTL_HOURS=72
CORS_ORIGIN=http://localhost:3000

# --- worker ---
HEALTH_ADDR=:9090

# --- console ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- 크리덴셜 봉투 암호화 (api 암호화 · worker 복호화) ---
# base64 32바이트. 생성: openssl rand -base64 32
# 아래 값은 로컬 dev 전용 — 프로덕션은 반드시 새로 생성. SaaS는 v1.5에 KMS 교체.
ONDA_MASTER_KEY=lJRl9VwZCg/+Fq/ZzoVGsNbWvqnQ2TwBJ17ZtDVFu9Q=
# KMS_MASTER_KEY_FILE=   # 파일 경로 대안 (셀프호스팅)
