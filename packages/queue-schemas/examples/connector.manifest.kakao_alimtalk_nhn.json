{
  "manifest_version": 0,
  "id": "kakao_alimtalk_nhn",
  "name": "카카오 알림톡 (NHN Cloud)",
  "description": "NHN Cloud Notification(KakaoTalk Bizmessage) API를 통한 알림톡 발송. 사전 승인 템플릿 + 변수 치환, 비동기 결과 콜백, SMS 폴백 지원.",
  "version": "0.1.0",
  "channel": "kakao_alimtalk",
  "vendor": { "name": "NudgeOn", "url": "https://github.com/NudgeOn/nudgeon-platform", "support": "https://github.com/NudgeOn/nudgeon-platform/issues" },
  "license": "Apache-2.0",
  "tier": "core",
  "runtime": { "type": "in_process_go", "go_package": "github.com/nudgeon/nudgeon-platform/apps/worker/internal/channel/alimtalk", "timeout_ms": 5000 },
  "target_types": ["phone"],
  "capabilities": {
    "content": ["template", "buttons"],
    "silent": false,
    "fallback_source": true,
    "scheduled_send": false,
    "batch_max": 1,
    "async_receipt": true,
    "test_send": true
  },
  "credentials": {
    "schema": {
      "type": "object",
      "required": ["app_key", "secret_key", "sender_key"],
      "properties": {
        "app_key": { "type": "string", "title": "NHN Cloud App Key" },
        "secret_key": { "type": "string", "title": "Secret Key", "x-secret": true },
        "sender_key": { "type": "string", "title": "카카오 발신프로필 키" }
      },
      "additionalProperties": false
    },
    "validate": true
  },
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "default_template_code": { "type": "string" },
        "sms_fallback_sender": { "type": "string", "title": "SMS 폴백 발신번호(사전 등록)" }
      }
    }
  },
  "lifecycle": {
    "reports": ["accepted", "sent", "delivered", "failed", "clicked"],
    "callback": { "path": "nhn/result", "verify": "token" }
  },
  "limits": { "rps": 50, "retry": { "max_attempts": 3, "base_backoff_ms": 2000, "circuit_breaker": true } },
  "compliance": {
    "regions": ["KR"],
    "marketing_allowed": false,
    "requires_template_approval": true,
    "ad_label": "none",
    "unsubscribe": "none",
    "quiet_hours_default": null,
    "pii_in_transit": ["phone"]
  },
  "cost": { "currency": "KRW", "per_message": 8.0 },
  "contract_tests": ["validate_credentials", "send_ok", "send_invalid_target", "send_rate_limited", "send_permanent_content", "callback_parse", "idempotent_resend", "unsupported_content", "fallback_trigger"]
}
