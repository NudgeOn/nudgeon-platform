# Onda 셀프호스팅(Compose app 프로파일) 환경변수 예제.
#
#   cp deploy/.env.example deploy/.env
#   # deploy/.env 편집: ONDA_MASTER_KEY 등 시크릿 교체
#   docker compose -f deploy/compose.yaml --env-file deploy/.env --profile full --profile app up -d
#
# 주소는 Compose 네트워크의 서비스명 기준(컨테이너 내부)이다.
# 저장소 루트의 .env.example은 호스트에서 api/worker를 로컬 실행할 때용(localhost:5433 등)이며
# 컨테이너에 그대로 주입하면 안 된다.

# --- 데이터 저장소 (컨테이너 내부 서비스명·기본 포트) ---
DATABASE_URL=postgres://onda:onda@postgres:5432/onda
REDIS_URL=redis://redis:6379
CLICKHOUSE_URL=http://onda:onda@clickhouse:8123/onda

# --- api ---
# multi_tenant(SaaS) | single_tenant(셀프호스팅 — 가입 대신 초기 관리자 셋업)
MODE=single_tenant
CORS_ORIGIN=http://localhost:3000

# --- console (클라이언트 번들에 구워지는 값) ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- 크리덴셜 봉투 암호화 (필수) ---
# 반드시 새로 생성: openssl rand -base64 32
# 아래 placeholder를 그대로 쓰지 말 것.
ONDA_MASTER_KEY=CHANGE_ME_openssl_rand_base64_32
